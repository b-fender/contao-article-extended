{
    "name": "pedro-go/contao-article-extended",
    "type": "contao-bundle",
    "description": "Erweitert Contao-Artikel um konfigurierbare Design-Eigenschaften (Abstände, max. Breite, Hintergrundfarbe), deren Auswahllisten im Backend gepflegt werden.",
    "keywords": ["contao", "contao-bundle", "article", "design", "spacing", "layout"],
    "homepage": "https://github.com/pedro-go/contao-article-extended",
    "license": "MIT",
    "authors": [
        {
            "name": "pedro-go"
        }
    ],
    "support": {
        "issues": "https://github.com/pedro-go/contao-article-extended/issues",
        "source": "https://github.com/pedro-go/contao-article-extended"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "PedroGo\\ArticleExtendedBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "PedroGo\\ArticleExtendedBundle\\ContaoManager\\Plugin"
    }
}
