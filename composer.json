{
    "name": "b-fender/contao-article-extended",
    "type": "contao-bundle",
    "description": "Erweitert Contao-Artikel um konfigurierbare Design-Eigenschaften (Abstände, max. Breite, Hintergrundfarbe), deren Auswahllisten im Backend gepflegt werden.",
    "license": "MIT",
    "authors": [
        {
            "name": "b-fender"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "BFender\\ArticleExtendedBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "BFender\\ArticleExtendedBundle\\ContaoManager\\Plugin"
    }
}
