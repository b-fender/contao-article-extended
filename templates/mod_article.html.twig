{#
    Referenz-Template für den Artikel-Wrapper mit den Design-Eigenschaften
    aus diesem Bundle (pt, pb, mt, mb, mw, bgcolor, ad_noinside).

    WICHTIG: Diese Datei wird NICHT automatisch verwendet. Seit Contao 5.7
    ist Twig der Standard, und Twig-Templates aus Bundles überschreiben
    den Core nicht zuverlässig auf die gleiche Art wie frühere .html5-
    Dateien. Der von Contao offiziell unterstützte und getestete Weg ist,
    diese Datei als PROJEKT-Override über das Template Studio anzulegen:

    1. Backend → Layout → Template Studio → nach "mod_article" suchen
    2. Im geöffneten "mod_article"-Tab oben rechts auf
       "Ihr Template erstellen" klicken
    3. Den kompletten vorbelegten Inhalt löschen und durch den Inhalt
       dieser Datei ersetzen
    4. Speichern

    Danach liegt die Datei als /templates/mod_article.html.twig im
    Contao-Projekt selbst und hat automatisch Vorrang vor der
    Core-Twig-Vorlage @Contao/mod_article.html.twig.
#}

{% set wrapperAttributes = attrs(cssID)
    .addClass([class, 'block', pt|default, pb|default, mt|default, mb|default, mw|default, bgcolor|default])
    .addStyle(style|default)
    .mergeWith(wrapperAttributes|default)
%}

{% if teaserOnly|default %}

    {% block alias %}
        <article{{ wrapperAttributes }}>
            <div class="ce_text content-text block">
                <h2>{{ headline|insert_tag_raw }}</h2>
                <div class="teaser">
                    {{ teaser|default|sanitize_html('contao')|csp_inline_styles|insert_tag_raw }}
                    <p class="more"><a href="{{ href }}" title="{{ readMore }}">{{ more }} <span class="invisible">{{ headline }}</span></a></p>
                </div>
            </div>
        </article>
    {% endblock %}

{% elseif noMarkup|default %}

    {% block content %}
        {{ elements|join|raw }}
    {% endblock %}

{% else %}

    <div{{ wrapperAttributes }}>
        {% if not ad_noinside|default %}<div class="inside">{% endif %}

        {% if printable %}
            {% block syndication %}
                <!-- indexer::stop -->
                <div class="syndication">
                    {% if printButton %}
                        <a href="{{ print }}" class="print" title="{{ printTitle }}" onclick="window.print();return false" data-skip-search-index>{{ backend_icon('assets/contao/images/print.svg') }}</a>
                    {% endif %}
                    {% if facebookButton %}
                        <a href="{{ path('contao_frontend_share', {p: 'facebook', u: encUrl}) }}" class="facebook" rel="nofollow" title="{{ facebookTitle }}" onclick="var w=window.open(this.href,'','width=640,height=380,modal=yes,left=100,top=50,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no');w.opener=null;return false">{{ backend_icon('assets/contao/images/facebook.svg') }}</a>
                    {% endif %}
                    {% if twitterButton %}
                        <a href="{{ path('contao_frontend_share', {p: 'twitter', u: encUrl, t: encTitle}) }}" class="twitter" rel="nofollow" title="{{ twitterTitle }}" onclick="var w=window.open(this.href,'','width=640,height=380,modal=yes,left=100,top=50,location=no,menubar=no,resizable=yes,scrollbars=yes,status=no,toolbar=no');w.opener=null;return false">{{ backend_icon('assets/contao/images/twitter.svg') }}</a>
                    {% endif %}
                </div>
                <!-- indexer::continue -->
            {% endblock %}
        {% endif %}

        {{ block('content') }}

        {% if backlink %}
            {% block backlink %}
                <!-- indexer::stop -->
                <p class="back"><a href="{{ backlink }}" title="{{ back }}">{{ back }}</a></p>
                <!-- indexer::continue -->
            {% endblock %}
        {% endif %}

        {% if not ad_noinside|default %}</div>{% endif %}
    </div>

{% endif %}
